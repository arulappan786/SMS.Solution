@page "/login"

@layout EmptyLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ApiClient ApiClient
@inject IHttpClientFactory HttpClientFactory

<div class="p-5">
    <EditForm Model="loginModel" FormName="Login" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" class="form-control" type="password" @bind-Value="loginModel.Password" />
        </div>
        <button type="submit" class="btn btn-primary mt-3">Login</button>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="text-danger mt-2">@errorMessage</div>
        }
    </EditForm>
</div>


@code {

    private LoginModel loginModel = new LoginModel() { Email = "", Password = "" };

    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        HttpClient client = HttpClientFactory.CreateClient("NoAuthClient");
        var response = await client.PostAsJsonAsync("api/auth/login", loginModel);

        if(response.IsSuccessStatusCode)
        {
            var loginWrapper = await response.Content.ReadFromJsonAsync<ServiceResponse<LoginResponseModel>>();

            if (loginWrapper != null && loginWrapper.Succeeded && loginWrapper.Data != null)
            {
                var loginResult = loginWrapper.Data;

                await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(loginResult);
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
    }
}
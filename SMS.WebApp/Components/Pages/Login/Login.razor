@page "/login"

@layout EmptyLayout
@inject NavigationManager Navigation
@inject ApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider


<div class="p-5">
    <EditForm Model="loginModel" FormName="Login" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" class="form-control" type="password" @bind-Value="loginModel.Password" />
        </div>
        <button type="submit" class="btn btn-primary mt-3">Login</button>
    </EditForm>
</div>


@code {
    private LoginModel loginModel = new LoginModel() { Email = "", Password = "" };

    private async Task HandleLogin()
    {
        var res = await ApiClient.PostAsync<ServiceResponse, LoginModel>("/api/auth/login", loginModel);

        if (res is null) return;
        if (!res.Succeeded) return;
        if (res.Data is null) return;

        // FIX: Use Newtonsoft.Json.JsonConvert.SerializeObject instead of JsonSerializer.Serialize
        string jsonString = JsonConvert.SerializeObject(res.Data);

        // 2. Deserialize the JSON string into the strongly-typed model
        var loginResult = JsonConvert.DeserializeObject<LoginResponseModel>(jsonString);

        if (loginResult != null && loginResult.AccessToken != null)
        {
            await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(loginResult!);
            Navigation.NavigateTo("/");
        }
    }
}

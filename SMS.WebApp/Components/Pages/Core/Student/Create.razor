@page "/students/create"


@attribute [Authorize(Roles = "Admin")]
@inject ApiClient apiClient
@inject ToastService ToastService

<PageHeader Title="@PageTitle" />

<EditForm Model="@student" OnValidSubmit="HandleValidSubmit" FormName="createStudent">
    <ObjectGraphValidator />
    
    <fieldset class="form-group">
        <legend>Personal Information</legend>

        <div class="mb-3">
            <label for="firstName" class="form-label">First Name</label>
            <InputText id="firstName" class="form-control" @bind-Value="student.FullName.FirstName" />
            <ValidationMessage For="@(() => student.FullName.FirstName)" />
        </div>

        <div class="mb-3">
            <label for="lastName" class="form-label">Last Name</label>
            <InputText id="lastName" class="form-control" @bind-Value="student.FullName.LastName" />
            <ValidationMessage For="@(() => student.FullName.LastName)" />
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="student.Email" />
            <ValidationMessage For="@(() => student.Email)" />
        </div>

        <div class="mb-3">
            <label for="dob" class="form-label">Date of Birth</label>
            <InputDate id="dob" class="form-control" @bind-Value="student.DateOfBirth" />
            <ValidationMessage For="@(() => student.DateOfBirth)" />
        </div>

        <div class="mb-3">
            <label for="gender" class="form-label">Gender</label>
            <InputSelect id="gender" class="form-select" @bind-Value="student.Gender">
                @* <option value="@((int)Gender.Male)">Male</option>
                <option value="@((int)Gender.Female)">Female</option>
                <option value="@((int)Gender.Other)">Other</option> *@
                <option value="@Gender.Male">Male</option>
                <option value="@Gender.Female">Female</option>
                <option value="@Gender.Other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => student.Gender)" />
        </div>        

        <div class="mb-3">
            <label for="classId" class="form-label">Academic Year</label>
            <InputSelect id="classId" class="form-select" @bind-Value="student.CurrentClassId">
                <option value="">Select Class</option>
                @if (Classes != null)
                {
                    @foreach (var cls in Classes)
                    {
                        <option value="@cls.Id">@cls.Name</option>
                    }
                }
            </InputSelect>
            <ValidationMessage For="@(() => student.CurrentClassId)" />
        </div>

    </fieldset>

    <fieldset class="form-group mt-4">
        <legend>Home Address</legend>

        <div class="mb-3">
            <label for="street" class="form-label">Street</label>
            <InputText id="street" class="form-control" @bind-Value="student.HomeAddress.Street" />
            <ValidationMessage For="@(() => student.HomeAddress.Street)" />
        </div>

        <div class="mb-3">
            <label for="city" class="form-label">City</label>
            <InputText id="city" class="form-control" @bind-Value="student.HomeAddress.City" />
            <ValidationMessage For="@(() => student.HomeAddress.City)" />
        </div>

        <div class="mb-3">
            <label for="state" class="form-label">State</label>
            <InputText id="state" class="form-control" @bind-Value="student.HomeAddress.State" />
            <ValidationMessage For="@(() => student.HomeAddress.State)" />
        </div>

        <div class="mb-3">
            <label for="zipCode" class="form-label">Zip Code</label>
            <InputText id="zipCode" class="form-control" @bind-Value="student.HomeAddress.ZipCode" placeholder="e.g., 110001 or 98765" />
            <ValidationMessage For="@(() => student.HomeAddress.ZipCode)" />
        </div>

        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <InputText id="country" class="form-control" @bind-Value="student.HomeAddress.Country" />
            <ValidationMessage For="@(() => student.HomeAddress.Country)" />
        </div>

    </fieldset>

    <div class="d-flex justify-content-end bg-body-secondary rounded-2 mt-3 p-3">
        <a class="btn btn-primary" href="/academic/classes">Back To List</a>
        <button type="submit" class="btn btn-success ms-2">Create Student</button>
    </div>

    <p class="text-success mt-2">@successMessage</p>
    <p class="text-danger mt-2">@errorMessage</p>

</EditForm>


@code {
    // 1. Initialize the Student model to be bound to the form
    private string PageTitle => "Create New Student";
    private CreateStudentModel student = new CreateStudentModel();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private IEnumerable<ClassesModel>? Classes;

    override protected async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadClasses();
    }

    // 2. This method is called when the form submission is valid
    private async Task HandleValidSubmit()
    {
        successMessage = "Submitting...";
        errorMessage = string.Empty;

        // The URL of your API endpoint
        string apiUrl = "api/student";

        try
        {
            // 3. Send the model object to the API
            // HttpClient will serialize the C# object 'student' into the required JSON structure.
            var response = await apiClient.PostAsync<ServiceResponse<StudentDto>, CreateStudentModel>(apiUrl, student);

            if (response.Succeeded)
            {
                successMessage = "Student created successfully!";
                errorMessage = string.Empty;
                // Optionally reset the form:
                // student = new Student();
            }
            else
            {
                // Read the error message from the API response
                var errorContent = response.Message;
                errorMessage = $"Error: => Details: {errorContent}";
                successMessage = string.Empty;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            successMessage = string.Empty;
        }
    }

    private async Task LoadClasses()
    {
        var response = await apiClient.GetFromJsonAsync<ServiceResponse<PaginatedResult<ClassesModel>>>("/api/class");

        if (response != null && response.Succeeded && response.Data != null)
        {
            Classes = response.Data.Items;
        }
    }
}
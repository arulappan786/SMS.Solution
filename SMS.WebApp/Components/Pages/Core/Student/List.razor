@page "/students"

@attribute [Authorize(Roles = "Admin")]

@inject ApiClient apiClient
@inject NavigationManager NavManager
@inject ToastService ToastService
@rendermode InteractiveServer

<PageHeader Title="@PageTitle" />

<div class="d-flex justify-content-end">
    <NavLink class="btn btn-primary mb-3 rounded" href="/students/create">
        <i class="bi bi-plus" style="margin-right: 5px;"></i>
        Create New Student
    </NavLink>
</div>

@if (Students == null)
{
    <AppLoader Message="Fetching latest students..." />
}
else if (!Students.Any() || Students.Count  == 0)
{
    <NoDataFound Title="No students found." Message="Please add new students to view them here." />
}
else
{

    @* Pagination *@

    <PaginationHeader State="Pagination"
                      Navigate="HandlePageNavigation"
                      PageSizeChanged="HandlePageSizeChange"
                      SearchTermChanged="HandleSearchTermChange" />

    @* Student Listing *@

    <div class="table-responsive">

       @*  @if(Students.Count == 0)
        {
            <AppLoader Message="No students found." />
        } *@
    
        <table class="table table-bordered table-striped table-hover rounded">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Gender</th>
                    <th>Email</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Students)
                {
                    <tr>
                        <td>@student.StudentCode</td>
                        <td>@student.FullName.FirstName @student.FullName.LastName</td>
                        <td>
                            @if (student.CurrentClassName == "N/A")
                            {
                                <span class="text-muted fst-italic">Loading...</span>
                            }
                            else
                            {
                                @student.CurrentClassName
                            }
                        </td>
                        <td>@student.Gender</td>
                        <td>@student.Email</td>
                        <td class="d-flex justify-content-around">
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <a class="btn btn-secondary" href="/students/update/@student.Id">Update</a>
                                    <button class="btn btn-danger" @onclick="() => { DeleteID = student.Id; Modal?.Open(); }">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>   

    @* Models Popup Modal for Delete Confirmation *@

    <AppModal @ref="Modal">
        <Title>Notification</Title>
        <Body>
            Are you sure to delete the student?
        </Body>
        <Footer>
            <button type="button" class="btn btn-danger" style="width:80px" @onclick="HandleDelete">Yes</button>
            <button type="button" class="btn btn-primary" @onclick="() => Modal?.Close()">Cancel</button>
        </Footer>
    </AppModal>
}

@code {
    private PaginatedResult<StudentListItem> Result = new();
    private List<StudentListItem> Students => Result.Items;
    private string PageTitle => "Student List";
    private Guid DeleteID { get; set; }
    private AppModal? Modal;

    private PaginationState Pagination { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        await LoadData(Pagination.PageNumber);
    }

    private async Task LoadData(int pageNumber)
    {
        StateHasChanged();

        var path = $"api/student?pageNumber={pageNumber}&pageSize={Pagination.PageSize}";
        var response = await apiClient.GetFromJsonAsync<ServiceResponse<PaginatedResult<StudentListItem>>>(path);

        if (response != null && response.Succeeded && response.Data != null)
        {
            Result = response.Data;

            Pagination.PageNumber = Result.PageNumber;
            Pagination.TotalPages = Result.TotalPages;
            Pagination.TotalCount = Result.TotalCount;
            Pagination.HasPreviousPage = Result.HasPreviousPage;
            Pagination.HasNextPage = Result.HasNextPage;
        }
        else
        {
            Result = new PaginatedResult<StudentListItem>();
        }
    }

    private Task HandlePageNavigation(int newPage)
    {
        return LoadData(newPage);
    }

    private Task HandlePageSizeChange(int newSize)
    {
        return LoadData(1);
    }

    private Task HandleSearchTermChange(string term)
    {
        return LoadData(1);
    }

    protected async Task HandleDelete()
    {
        try
        {
            var res = await apiClient.DeleteAsync<ServiceResponse>($"/api/student/{DeleteID}");

            if (res != null && res.Succeeded)
            {
                ToastService.ShowSuccess("Student delete successfully!");
                await LoadData(1);
                Modal?.Close();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting student: {ex.Message}");
        }
    }
}
@page "/students"

@attribute [Authorize(Roles = "Admin")]

@inject ApiClient apiClient
@inject NavigationManager NavManager
@inject ToastService ToastService
@* @rendermode InteractiveServer *@

<PageHeader Title="@PageTitle" />

@if (Students == null)
{
    <AppLoader Message="Fetching latest students..." />
}
else
{
    <div class="d-flex justify-content-end">
        <NavLink class="btn btn-primary mb-3 rounded" href="/students/create">
            <i class="bi bi-plus" style="margin-right: 5px;"></i>
            Create New Student
        </NavLink>
    </div>

    <div class="d-flex justify-content-end bg-body-secondary rounded-2 mt-3 p-3">
        <label for="pageSizeSelect" class="form-label mb-0">Items per page:</label>
        <select id="pageSizeSelect"
                class="form-select form-select-sm"
                @bind:after="HandlePageSizeChange"
                @bind="SelectedPageSize"
                style="width: auto;">

            @foreach (var size in PageSizeOptions)
            {
                <option value="@size">@size</option>
            }
        </select>
    </div>

    @* Student Listing *@

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover rounded">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Gender</th>
                    <th>Email</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Students)
                {
                    <tr>
                        <td>@student.StudentCode</td>
                        <td>@student.FullName.FirstName @student.FullName.LastName</td>
                        <td>
                            @if (student.CurrentClassName == "N/A")
                            {
                                <span class="text-muted fst-italic">Loading...</span>
                            }
                            else
                            {
                                @student.CurrentClassName
                            }
                        </td>
                        <td>@student.Gender</td>
                        <td>@student.Email</td>
                        <td class="d-flex justify-content-around">
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <a class="btn btn-secondary" href="/students/update/@student.Id">Update</a>
                                    <button class="btn btn-danger" @onclick="() => { DeleteID = student.Id; Modal?.Open(); }">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination *@

    <div class="d-flex align-items-center justify-content-center gap-3">
        <button class="btn btn-secondary"
                disabled="@(!Result.HasPreviousPage)"
                @onclick="@(() => LoadPage(Result.PageNumber - 1))">
            Previous
        </button>

        <span>Page @Result.PageNumber of @Result.TotalPages</span>

        <button class="btn btn-secondary"
                disabled="@(!Result.HasNextPage)"
                @onclick="@(() => LoadPage(Result.PageNumber + 1))">
            Next
        </button>
    </div>

    @* Models Popup Modal for Delete Confirmation *@

    <AppModal @ref="Modal">
        <Title>Notification</Title>
        <Body>
            Are you sure to delete the class?
        </Body>
        <Footer>
            <button type="button" class="btn btn-danger" style="width:80px" @onclick="HandleDelete">Yes</button>
            <button type="button" class="btn btn-primary" @onclick="() => Modal?.Close()">Cancel</button>
        </Footer>
    </AppModal>
}

@code {
    private PaginatedResult<StudentListItem> Result = new();
    private List<StudentListItem> Students => Result.Items;
    private bool IsLoading = true;
    private int CurrentPage = 1;
    private string PageTitle => "Student List";
    private Guid DeleteID { get; set; }
    private AppModal? Modal;

    private int SelectedPageSize { get; set; } = 10;

    private List<int> PageSizeOptions = new List<int> {5, 10, 25, 50, 75, 100 };

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(CurrentPage);
    }

    private async Task LoadPage(int pageNumber)
    {
        StateHasChanged();

        var path = $"api/student?pageNumber={pageNumber}&pageSize={SelectedPageSize}";
        var response = await apiClient.GetFromJsonAsync<ServiceResponse<PaginatedResult<StudentListItem>>>(path);

        if (response != null && response.Succeeded && response.Data != null)
        {
            Result = response.Data;
            CurrentPage = Result.PageNumber;
        }
        else
        {
            Result = new PaginatedResult<StudentListItem>();
        }
    }

    private async Task HandlePageSizeChange()
    {
        await LoadPage(1);
    }

    protected async Task HandleDelete()
    {
        var res = await apiClient.DeleteAsync<ServiceResponse>($"/api/class/{DeleteID}");

        if (res != null && res.Succeeded)
        {
            ToastService.ShowSuccess("Class delete successfully!");
            await LoadPage(CurrentPage);
            Modal?.Close();
        }
    }

}
@page "/academic/classes/list"
@page "/academic/classes"

@attribute [Authorize(Roles = "Admin")]
@inject ApiClient apiClient
@inject ToastService ToastService

<h3>@PageTitle</h3>

@if (Classes == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-end">
        <NavLink class="btn btn-primary mb-3 rounded" href="/academic/classes/create">
            <i class="bi bi-plus" style="margin-right: 5px;"></i>
            Create New Class
        </NavLink>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover rounded">
            <thead>
                <tr>
                    <th>Academic Year</th>
                    <th>Class Name</th>
                    <th>Maximum Capacity</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Classes)
                {
                    <tr>
                        <td>@item.AcademicYearName</td>
                        <td>@item.Name</td>
                        <td>@item.MaxCapacity</td>
                        <td class="d-flex justify-content-around">
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <a class="btn btn-secondary" href="/academic/classes/update/@item.Id">Update</a>
                                    <button class="btn btn-danger" @onclick="() => { DeleteID = item.Id; Modal?.Open(); }">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <AppModal @ref="Modal">
            <Title>Notification</Title>
            <Body>
                Are you sure to delete the class?
            </Body>
            <Footer>
                <button type="button" class="btn btn-primary" style="width:80px" @onclick="HandleDelete">Yes</button>
                <button type="button" class="btn btn-secondary" @onclick="() => Modal?.Close()">Cancel</button>
            </Footer>
        </AppModal>
    </div>
}

@code {
    private string PageTitle => "Classes List";
    private IEnumerable<ClassesModel>? Classes;
    private Guid DeleteID { get; set; }
    private AppModal? Modal;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadClasses();
    }

    protected async Task HandleDelete()
    {
        var res = await apiClient.DeleteAsync<ServiceResponse>($"/api/class/{DeleteID}");

        if (res != null && res.Succeeded)
        {
            ToastService.ShowSuccess("Class delete successfully!");
            await LoadClasses();
            Modal?.Close();
        }
    }

    protected async Task LoadClasses()
    {
        try
        {
            // Call the authenticated API Client
            var response = await apiClient.GetFromJsonAsync<ServiceResponse<PaginatedResult<ClassesModel>>>("/api/class");

            if (response != null && response.Succeeded && response.Data != null)
            {
                // Assuming the API returns a List<AcademicYearModel> nested inside the generic wrapper
                Classes = response.Data.Items;
            }
            else
            {
                // Handle API failure response or non-successful status code
                Console.Error.WriteLine("Failed to load Academic Years. API call was unsuccessful.");
            }
        }
        catch (Exception ex)
        {
            // Handle network or token handler exceptions
            Console.Error.WriteLine($"Error during API call: {ex.Message}");
        }
    }
}
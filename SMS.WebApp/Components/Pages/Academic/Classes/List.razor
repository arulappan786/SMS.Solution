@page "/academic/classes"

@attribute [Authorize(Roles = "Admin")]

@inject ApiClient apiClient
@inject ToastService ToastService

<PageHeader Title="@PageTitle" />

@if (Classes == null)
{
    <AppLoader Message="Fetching latest Classes..." />
}
else
{
    <div class="d-flex justify-content-end">
        <NavLink class="btn btn-primary mb-3 rounded" href="/academic/classes/create">
            <i class="bi bi-plus" style="margin-right: 5px;"></i>
            Create New Class
        </NavLink>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover rounded">
            <thead>
                <tr>
                    <th>Academic Year</th>
                    <th>Class Name</th>
                    <th>Maximum Capacity</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Classes)
                {
                    <tr>
                        <td>@item.AcademicYearName</td>
                        <td>@item.Name</td>
                        <td>@item.MaxCapacity</td>
                        <td class="d-flex justify-content-around">
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <a class="btn btn-secondary" href="/academic/classes/update/@item.Id">Update</a>
                                    <button class="btn btn-danger" @onclick="() => { DeleteID = item.Id; Modal?.Open(); }">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <AppModal @ref="Modal">
            <Title>Notification</Title>
            <Body>
                Are you sure to delete the class?
            </Body>
            <Footer>
                <button type="button" class="btn btn-danger" style="width:80px" @onclick="HandleDelete">Yes</button>
                <button type="button" class="btn btn-primary" @onclick="() => Modal?.Close()">Cancel</button>
            </Footer>
        </AppModal>
    </div>
}

@code {
    private string PageTitle => "Classes List";
    private IEnumerable<ClassesModel>? Classes;
    private Guid DeleteID { get; set; }
    private AppModal? Modal;

    // --- 1. Inject AuthenticationStateProvider ---
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    // --- 2. Remove OnInitializedAsync and use OnParametersSetAsync ---
    protected override async Task OnParametersSetAsync()
    {
        // Wait for the Blazor AuthenticationStateProvider to determine the user's identity
        var authState = await authenticationState;
        var user = authState?.User;

        // Only proceed to load data if the user is authenticated (and implicitly, authorized)
        if (user?.Identity?.IsAuthenticated == true && user.IsInRole("Admin"))
        {
            // Clear existing data/show loader
            Classes = null;
            await LoadClasses();
        }
        else
        {
            // If not authorized, ensure Classes is null, and the page shows the NotAuthorized content
            Classes = null;
        }
    }

    protected async Task HandleDelete()
    {
        var res = await apiClient.DeleteAsync<ServiceResponse>($"/api/class/{DeleteID}");

        if (res != null && res.Succeeded)
        {
            ToastService.ShowSuccess("Class delete successfully!");
            await LoadClasses();
            Modal?.Close();
        }
    }

    protected async Task LoadClasses()
    {
        var response = await apiClient.GetFromJsonAsync<ServiceResponse<PaginatedResult<ClassesModel>>>("/api/class");

        if (response != null && response.Succeeded && response.Data != null)
        {
            Classes = response.Data.Items;
        }
    }
}